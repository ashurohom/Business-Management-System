<odoo>

    <record id="view_product_alias_import_wizard" model="ir.ui.view">
        <field name="name">product.alias.import.wizard</field>
        <field name="model">dw.product.alias.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import SKU / Alternate Names">
                <group>
                    <field name="file"/>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_alias_import_wizard" model="ir.actions.act_window">
        <field name="name">Import SKU / Alternate Names</field>
        <field name="res_model">dw.product.alias.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add inside Products menu -->
    <menuitem id="menu_product_alias_import"
          name="Import SKU Names"
          parent="sale.product_menu_catalog"
          action="action_product_alias_import_wizard"
          sequence="99"/>

</odoo>
