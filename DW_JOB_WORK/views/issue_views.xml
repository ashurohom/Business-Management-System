<odoo>
    <record id="view_job_work_issue_tree" model="ir.ui.view">
        <field name="name">dw.job.work.issue.tree</field>
        <field name="model">dw.job.work.issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="issue_date"/>
                <field name="contractor_id"/>
                <field name="remaining_qty"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_job_work_issue_form" model="ir.ui.view">
        <field name="name">dw.job.work.issue.form</field>
        <field name="model">dw.job.work.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="contractor_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="remaining_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_free_qty" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="remaining_qty" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="job_work_issue_action" model="ir.actions.act_window">
        <field name="name">Job Work Issue</field>
        <field name="res_model">dw.job.work.issue</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
