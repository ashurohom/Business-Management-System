<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_form_indiamart_push" model="ir.ui.view">
        <field name="name">crm.lead.form.indiamart.push</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="IndiaMART">
                    <group>
                        <group>
                            <field name="x_indiamart_query_id" readonly="1"/>
                            <field name="x_indiamart_source" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_indiamart_raw_data" readonly="1" widget="text"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

