<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_aged_partner_balance_filter" model="ir.ui.view">
        <field name="name">account.aged.trial.balance.partner.filter</field>
        <field name="model">account.aged.trial.balance</field>
        <field name="inherit_id" ref="base_accounting_kit.account_aged_balance_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='result_selection']" position="after">
                <field name="partner_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
